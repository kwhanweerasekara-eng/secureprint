# --- Database (used by docker-compose) ---
POSTGRES_USER=secureprint
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=secureprint
POSTGRES_PORT=5432

# --- API (apps/api) ---
DATABASE_URL=postgresql+psycopg2://secureprint:change_me_in_production@postgres:5432/secureprint
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
COOKIE_NAME=secureprint_session
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
ORGANISATION_NAME=SecurePrint Demo Org
MAX_UPLOAD_MB=25
ENVIRONMENT=development

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

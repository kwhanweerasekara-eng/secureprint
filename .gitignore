# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Storage (runtime data, never committed)
storage/incoming/*
storage/processing/*
storage/sanitized/*
!storage/incoming/.gitkeep
!storage/processing/.gitkeep
!storage/sanitized/.gitkeep
storage/*.db

# Node / Next.js
apps/web/node_modules/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/.env.local

# Env files
.env
apps/windows-agent/config.bat
apps/windows-agent/logs/

# OS / editor
.DS_Store
*.swp

# Local env files in any folder (the *.example files are kept)
.env.local
**/.env.local
*.log
logs/

# Local tools, backups and working notes (not part of the product)
.claude/
_backup-before-update-*/
CHANGES-*.txt
apps/linux-agent/agent.conf
apps/windows-agent/test.txt
